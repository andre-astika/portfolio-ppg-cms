# Username + password for the first admin account. Only used the very first
# time the app runs (when data/users.json doesn't exist yet) to seed the
# initial admin — change these before deploying!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Random long string used to sign session cookies. Change this too.
# Generate one with: openssl rand -hex 32
ADMIN_SECRET=change-me-to-a-long-random-string

# Max upload size (MB) for the media library / task files.
# Note: most hosting platforms cap request bodies well below 1GB — see
# README-CMS.md for details before setting this very high.
MAX_UPLOAD_MB=200
